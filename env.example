# Environment Configuration Example
# Copy this file to .env and update the values according to your environment

# Application Environment
NODE_ENV=development

# Backend API Configuration
VUE_APP_API_BASE_URL=http://localhost:8080
VUE_APP_API_TIMEOUT=30000
VUE_APP_USE_MOCK_DATA=true
VUE_APP_ENABLE_LOGGING=true

# Backend Integration Settings
VUE_APP_BACKEND_RETRY_MAX=3
VUE_APP_BACKEND_RETRY_DELAY=1000
VUE_APP_BACKEND_HEALTH_CHECK_INTERVAL=30000
VUE_APP_BACKEND_HEALTH_CHECK_TIMEOUT=5000

# Authentication Settings
VUE_APP_AUTH_SESSION_TIMEOUT=28800000
VUE_APP_AUTH_REFRESH_THRESHOLD=300000
VUE_APP_CAPTCHA_ENABLED=false

# Development Settings
VUE_APP_DEBUG_MODE=true
VUE_APP_MOCK_DELAY=500
VUE_APP_MOCK_ERROR_RATE=0

# Production Settings (uncomment for production)
# NODE_ENV=production
# VUE_APP_API_BASE_URL=https://api.sompo.com
# VUE_APP_USE_MOCK_DATA=false
# VUE_APP_ENABLE_LOGGING=false
# VUE_APP_CAPTCHA_ENABLED=true
# VUE_APP_DEBUG_MODE=false
